# Bu dosyayi .env olarak kopyalayin: cp .env.example .env
# .env dosyasi .gitignore'da - ASLA commit etmeyin.

NODE_ENV=development
PORT=3000

# Frontend ayri bir porttan calisacaksa doldurun (virgulle ayirin).
# Ayni sunucudan servis ediliyorsa bos birakin.
CORS_ORIGINS=

POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_TIMEOUT_MS=8000
POKEAPI_RETRIES=2

CACHE_DETAIL_TTL_MS=86400000
CACHE_LIST_TTL_MS=21600000
CACHE_MAX_ENTRIES=2000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Kisi 2 (database) buraya kendi degiskenlerini ekleyecek ----
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=pokemon_team_builder
